# AUZEF Chat Analiz — docker compose ortam değişkenleri.
#
# Bu dosyayı `.env` olarak kopyalayın. Tüm değerlerin makul varsayılanları
# `apps/backend/app/core/config.py` içinde tanımlıdır; buradakiler yalnızca
# compose ortamını açıkça belgelemek içindir.

# ── OpenRouter ────────────────────────────────────────────────────────────
# BURADA API ANAHTARI YOKTUR VE OLMAYACAKTIR.
#
# Model BYOK'tur (ADR §6/§9): anahtar kullanıcıdan yalnızca `X-OpenRouter-Key`
# header'ında gelir, sunucu tarafında bir ortam değişkeninde TUTULMAZ,
# PostgreSQL'e yazılmaz ve loglara girmez. Faz 2'de yalnızca AES-GCM ile
# şifrelenip Redis'te job süresi kadar TTL ile tutulacaktır.
#
# Buraya bir `OPENROUTER_API_KEY` satırı EKLEMEYİN: sunucu genelinde tek bir
# anahtar kullanmak, kullanıcı başına maliyet izolasyonunu ve BYOK modelini
# tamamen ortadan kaldırır.

# ── Veritabanı ve kuyruk ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://auzef:auzef@postgres:5432/auzef
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Object storage (MinIO) ────────────────────────────────────────────────
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=auzef-uploads
S3_REGION=us-east-1

# ── Sınırlar (ADR §9: sınırlar sabit kodlanmaz, config'tir) ───────────────
# Sıkıştırılmış upload sınırı: 150 MB
MAX_UPLOAD_BYTES=157286400
# OOXML açılmış toplam boyut sınırı: 1 GB — ZIP bomba savunması
MAX_UNCOMPRESSED_BYTES=1073741824
# Tek bir zip üyesi için azami sıkıştırma oranı
MAX_COMPRESSION_RATIO=200
# Satır sınırı: aşılırsa iş başarısız olmaz, profilde işaretlenir
MAX_ROWS=100000

# ── Retention (ADR §9) ────────────────────────────────────────────────────
# "Toplu ve redakte rapor varsayılan 24 saat tutulur; kullanıcı elle
# silebilir ve gerçek kurum politikası onaylanınca config değiştirilir."
# Süresi dolan analiz kaydı raporuyla birlikte silinir.
REPORT_RETENTION_HOURS=24
# Ham upload kaydı ve dosyası için üst sınır. Dosya normalde analiz
# bitiminde zaten siliniyor; bu, hiç analiz edilmemiş dosyalar için tavan.
UPLOAD_RETENTION_HOURS=24
# "Kaçak dosyalar için azami 24 saat" — veritabanında karşılığı olmayan
# nesneler. Bucket lifecycle kuralı ek bir ağ olarak duruyor ama gün
# granülaritesinde (24-48 saat); asıl uygulayıcı süpürücüdür.
ORPHAN_OBJECT_RETENTION_HOURS=24
# Süpürücünün çalışma sıklığı (Celery beat). Retention penceresinin çok
# altında olmalı.
RETENTION_SWEEP_INTERVAL_SECONDS=3600

# ── Frontend ──────────────────────────────────────────────────────────────
# Gerçek backend için /api/v1, mock'a dönmek için /api/mock/v1.
# NEXT_PUBLIC_* değerleri imaja BUILD ZAMANINDA gömülür (bkz. web.Dockerfile).
NEXT_PUBLIC_API_BASE_URL=/api/v1
