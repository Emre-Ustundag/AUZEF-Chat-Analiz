# Kök ortam şablonu. Kopyalayın: cp .env.example .env
# .env commit EDİLMEZ; gerçek anahtarları yalnızca oraya yazın.

# Docker Compose bu dosyayı otomatik okur ve build argümanı olarak geçirir.
# `npm run dev` bunu değil apps/web/.env.local dosyasını okur.
NEXT_PUBLIC_API_BASE_URL=/api/mock/v1

# BYOK: bu değişkeni hiçbir kod okumaz ve okumaması tasarım gereğidir.
# ADR-0001 §9 — anahtar kullanıcıdan arayüzde alınır, yalnızca
# X-OpenRouter-Key header'ında taşınır ve sunucuda kalıcı tutulmaz.
# Yalnızca yerel geliştirmede elinizin altında dursun diye burada.
OPENROUTER_API_KEY=

# BE-02 ve sonrası için rezerve; bu servisler henüz tanımlı değil.
DATABASE_URL=
REDIS_URL=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Backend çalışma sınırları (app/core/config.py, AUZEF_ öneki).
# Hepsinin kodda varsayılanı var; yalnızca değiştireceğinizi yazın.
# NOT: backend YALNIZCA bu kök dosyayı okur; apps/backend/.env yok sayılır.
# AUZEF_MAX_UNCOMPRESSED_BYTES=1073741824
# AUZEF_ANALYSIS_TIMEOUT_SECONDS=2700
# AUZEF_IDEMPOTENCY_TTL_SECONDS=86400
#
# AUZEF_MAX_UPLOAD_BYTES ve AUZEF_MAX_ROWS BİLEREK YOK: frontend'in uyguladığı
# iki sınır sözleşmede donmuştur (ADR-0002 #13). Değiştirmek bir sözleşme
# değişikliğidir: config.py sabiti + contract_version bump + `make generate` +
# frontend LIMITS sabiti birlikte güncellenir.
