# AUZEF Chat Analiz — docker compose ortam değişkenleri.
#
# Bu dosyayı `.env` olarak kopyalayın. Tüm değerlerin makul varsayılanları
# `apps/backend/app/core/config.py` içinde tanımlıdır; buradakiler yalnızca
# compose ortamını açıkça belgelemek içindir.

# ── OpenRouter ────────────────────────────────────────────────────────────
# BURADA API ANAHTARI YOKTUR VE OLMAYACAKTIR.
#
# Model BYOK'tur (ADR §6/§9): anahtar kullanıcıdan yalnızca `X-OpenRouter-Key`
# header'ında gelir, sunucu tarafında bir ortam değişkeninde TUTULMAZ,
# PostgreSQL'e yazılmaz ve loglara girmez. Faz 2'de yalnızca AES-GCM ile
# şifrelenip Redis'te job süresi kadar TTL ile tutulacaktır.
#
# Buraya bir `OPENROUTER_API_KEY` satırı EKLEMEYİN: sunucu genelinde tek bir
# anahtar kullanmak, kullanıcı başına maliyet izolasyonunu ve BYOK modelini
# tamamen ortadan kaldırır.

# Model fiyatları public OpenRouter `/models` kataloğundan yenilenir; API
# anahtarı gerektirmez. Başarısızlıkta 7 güne kadar Redis'teki son
# snapshot, o da yoksa kodla birlikte sürümlenen yedek fiyatlar kullanılır.
AUZEF_PRICING_REFRESH_ENABLED=true
AUZEF_PRICING_REQUEST_TIMEOUT_SECONDS=5
AUZEF_PRICING_CACHE_TTL_SECONDS=3600
AUZEF_PRICING_STALE_TTL_SECONDS=604800

# ── Veritabanı ve kuyruk ──────────────────────────────────────────────────
AUZEF_DATABASE_URL=postgresql+asyncpg://auzef:auzef@postgres:5432/auzef
AUZEF_REDIS_URL=redis://redis:6379/0
AUZEF_CELERY_BROKER_URL=redis://redis:6379/1
AUZEF_CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Object storage (MinIO) ────────────────────────────────────────────────
AUZEF_S3_ENDPOINT_URL=http://minio:9000
AUZEF_S3_ACCESS_KEY=minioadmin
AUZEF_S3_SECRET_KEY=minioadmin
AUZEF_S3_BUCKET=auzef-uploads
AUZEF_S3_REGION=us-east-1

# ── Sınırlar (ADR §9: sınırlar sabit kodlanmaz, config'tir) ───────────────
# Sıkıştırılmış upload sınırı 150 MB ve satır sınırı 100.000, frontend ile
# donmuş sözleşme sabitleridir; environment üzerinden değiştirilemez.
# OOXML açılmış toplam boyut tavanı: 4 GiB — ZIP bomba savunmasının
# İKİNCİL katmanı. 1 GiB'ti ve yük testinde düştü: 130,9 MB'lık gerçekçi
# bir dosya 1,12 GB'a açılıyor (oran 8,7 — bomba eşiğinin çok altında).
# Asıl savunma aşağıdaki oran kontrolü ve akış sırasında sayan gerçek
# bayt kontrolüdür; bu sayı yalnızca mutlak bir tavan.
AUZEF_MAX_UNCOMPRESSED_BYTES=4294967296
# Tek bir zip üyesi için azami sıkıştırma oranı
AUZEF_MAX_COMPRESSION_RATIO=200

# ── Retention (ADR §9) ────────────────────────────────────────────────────
# "Toplu ve redakte rapor varsayılan 24 saat tutulur; kullanıcı elle
# silebilir ve gerçek kurum politikası onaylanınca config değiştirilir."
# Süresi dolan analiz kaydı raporuyla birlikte silinir.
AUZEF_REPORT_RETENTION_HOURS=24
# Ham upload kaydı ve dosyası için üst sınır. Dosya normalde analiz
# bitiminde zaten siliniyor; bu, hiç analiz edilmemiş dosyalar için tavan.
AUZEF_UPLOAD_RETENTION_HOURS=24
# "Kaçak dosyalar için azami 24 saat" — veritabanında karşılığı olmayan
# nesneler. Bucket lifecycle kuralı ek bir ağ olarak duruyor ama gün
# granülaritesinde (24-48 saat); asıl uygulayıcı süpürücüdür.
AUZEF_ORPHAN_OBJECT_RETENTION_HOURS=24
# Süpürücünün çalışma sıklığı (Celery beat). Retention penceresinin çok
# altında olmalı.
AUZEF_RETENTION_SWEEP_INTERVAL_SECONDS=3600

# ── Idempotency (ADR §6, ADR-0002 #3) ─────────────────────────────────────
# `Idempotency-Key` kaydının Redis'te yaşama süresi. Sözleşme "kayıt 24 saat
# saklanır" diyor; TTL ilk istekte kurulur ve replay'lerde UZAMAZ, aksi hâlde
# düzenli retry eden bir istemci kaydı süresiz canlı tutardı.
AUZEF_IDEMPOTENCY_TTL_SECONDS=86400

# ADR §9: geliştirme CORS allowlist'i yalnızca açıkça tanımlı local
# origin'leri kabul eder; `["*"]` ADR ihlalidir. Üretimde frontend ve API
# aynı origin altında çalıştığı için bu liste BOŞALTILIR: CORS_ORIGINS=[]
AUZEF_ENVIRONMENT=development
AUZEF_LOG_LEVEL=INFO
AUZEF_CORS_ORIGINS=["http://localhost:3000"]
# Üretimde Base64 kodlu tam 32 byte zorunludur; gerçek değer commit edilmez.
AUZEF_BACKEND_MASTER_KEY=
# ⚠️ SÜRE BÜTÇESİ — ölçüldü, tahmin değil.
#
# Chunk başına 120 kayıt (`llm_chunk_max_records`) ve gerçek gemini-2.5-flash
# koşusunda chunk başına ~26 saniye (1.545 benzersiz kayıt = 13 chunk).
#
# Kabaca: benzersiz_kayıt / 120 * 26 / AUZEF_LLM_MAP_CONCURRENCY saniye.
#
#   ~46.000 benzersiz, eşzamanlılık 1 -> ~2,8 saat (YETMEZ)
#   ~46.000 benzersiz, eşzamanlılık 8 -> ~21 dk   (sığar)
#
# Süre dolunca iş `PROVIDER_TIMEOUT` ile kapanır. Tamamlanmış map chunk'ları
# Redis önbelleğinde kaldığı için yeniden koşu onları tekrar ücretlendirmez
# (AUZEF_LLM_MAP_CACHE_ENABLED), ama iş yine baştan başlar.
#
# İKİSİ BİRLİKTE değişmeli: config `analysis_soft_timeout_seconds` hard
# timeout'tan KÜÇÜK olmalı diye doğruluyor (soft limit, işin sözleşmeye uygun
# bir hatayla kapanabilmesi için birkaç dakika önce gelir).
#
# YAN ETKİ: BYOK anahtarının Redis TTL'i buradan türer (+5 dk), yani anahtar
# da o kadar süre şifreli olarak Redis'te durur.
AUZEF_ANALYSIS_TIMEOUT_SECONDS=2700
AUZEF_ANALYSIS_SOFT_TIMEOUT_SECONDS=2640

# Reduce aşaması, tüm chunk kategorilerini tek prompt'a koymaz. Bu bütçe
# kategorilerin bir reduce çağrısında taşınabilecek yaklaşık toplam boyutunu
# sınırlar; büyük analizlerde hiyerarşik reduce turlarının parti genişliğidir.
AUZEF_LLM_REDUCE_MAX_PROMPT_TOKENS=12000

# Aynı anda uçuşta olabilecek map/reduce çağrısı sayısı. Sırayla gönderim
# 40 bin+ benzersiz kayıtta 45 dakikaya sığmıyordu; asıl darboğaz ağ bekleme
# süresidir, chunk'ı büyütmek çözmez (toplam completion token sabit).
#
# ÇIKTI BUNDAN ETKİLENMEZ: sonuçlar hangi sırada dönerse dönsün chunk indeks
# sırasında birleştirilir, rapor birebir aynı çıkar.
#
# Yan etki: maliyet tavanı aşıldığında uçuştaki çağrılar tamamlandığı için
# aşım payı en fazla bu sayı kadar çağrıdır (bkz. pipeline/cost.py).
AUZEF_LLM_MAP_CONCURRENCY=8

# Tamamlanmış map chunk'ları Redis'te önbelleklenir (TTL = rapor saklama
# süresi). Yarıda kalan bir koşunun ödenmiş chunk'ları, aynı dosyayla açılan
# YENİ analizde tekrar ücretlendirilmez — anahtar `analysis_id` taşımaz.
# İsabet, rapordaki token/maliyet alanlarına EKLENMEZ; o alanlar sağlayıcının
# bildirdiği gerçek tüketimdir. `false` yapmak yalnızca her koşuyu sıfırdan
# ücretlendirir, doğruluğu etkilemez.
AUZEF_LLM_MAP_CACHE_ENABLED=true

# ── Frontend ──────────────────────────────────────────────────────────────
# Gerçek backend için /api/v1, mock'a dönmek için /api/mock/v1.
# NEXT_PUBLIC_* değerleri imaja BUILD ZAMANINDA gömülür (bkz. web.Dockerfile).
NEXT_PUBLIC_API_BASE_URL=/api/v1
