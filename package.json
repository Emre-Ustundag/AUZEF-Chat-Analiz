{
  "name": "auzef-chat-analiz",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "start": "npm run start --workspace apps/web",
    "lint": "npm run lint --workspace apps/web",
    "typecheck": "npm run typecheck --workspace apps/web",
    "test": "npm run test --workspace apps/web",
    "test:contract": "npm run test:contract --workspace apps/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "backend:lint": "uv run --locked --project apps/backend ruff check apps/backend",
    "backend:test": "uv run --locked --project apps/backend pytest apps/backend",
    "openapi": "uv run --locked --project apps/backend python apps/backend/scripts/export_openapi.py",
    "fixtures": "uv run --locked --project apps/backend python apps/backend/scripts/export_fixtures.py",
    "contract": "npm run openapi -- --check && npm run fixtures -- --check && npm run test:contract",
    "e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "e2e:mock": "playwright test --config tests/e2e/playwright.config.ts --project=mock",
    "e2e:stack": "playwright test --config tests/e2e/playwright.config.ts --project=stack"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
